---
import { site } from "../site";
import { asset } from "../asset";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  description?: string;
  page: "home" | "features" | "pro" | "privacy" | "notfound";
  chrome?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title = site.title,
  description = site.description,
  page,
  chrome = page !== "home",
  jsonLd,
} = Astro.props;

const canonical =
  new URL(Astro.url.pathname, site.url).toString().replace(/\/$/, "") || site.url;
const ogImage = new URL("/og.png", site.url).toString();
const boot = page === "home";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070708" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" href="/fonts/Satoshi-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={asset("/assets/css/tokens.css")} />
    <link rel="stylesheet" href={asset("/assets/css/base.css")} />
    <link rel="stylesheet" href={asset("/assets/css/shell.css")} />
    <link rel="stylesheet" href={asset("/assets/css/home.css")} />
    <link rel="stylesheet" href={asset("/assets/css/inner.css")} />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>
  <body class:list={[`page-${page}`, boot && "is-booting"]}>
    <a class="skip" href="#main">Skip to content</a>
    <div class="site-shell">
      <div class="site-bg" aria-hidden="true"></div>
      {chrome && <Header />}
      <main id="main" class="site-main">
        <slot />
      </main>
      {chrome && <Footer />}
    </div>
    <Analytics />
    <SpeedInsights />
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
    <script is:inline src={asset("/assets/js/main.js")}></script>
    <script is:inline src={asset("/assets/js/motion.js")}></script>
    <script is:inline src={asset("/assets/js/interact.js")}></script>
    <script is:inline src={asset("/assets/js/transit.js")}></script>
  </body>
</html>
