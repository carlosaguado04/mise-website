---
const path = Astro.url.pathname;
---

<div class="scroll-progress" aria-hidden="true">
  <div class="scroll-progress-bar"></div>
</div>

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Mise home">
      <img src="/icon.png" width="24" height="24" alt="" />
      <span class="brand-text">Mise</span>
    </a>
    <div class="header-actions">
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Switch to light theme"
      >
        <span class="theme-toggle-icon" aria-hidden="true"></span>
      </button>
      <button
        type="button"
        class="nav-toggle"
        id="nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span data-nav-label>Menu</span>
      </button>
    </div>
  </div>
</header>

<nav class="nav" id="site-nav" aria-label="Primary" inert>
  <a href="/#features">
    <span class="nav-index">01</span>
    <span class="nav-text">Features</span>
  </a>
  <a href="/#status">
    <span class="nav-index">02</span>
    <span class="nav-text">Updates</span>
  </a>
  <a href="/contact" aria-current={path === "/contact" ? "page" : undefined}>
    <span class="nav-index">03</span>
    <span class="nav-text">Contact</span>
  </a>
  <a href="/changelog" aria-current={path === "/changelog" ? "page" : undefined}>
    <span class="nav-index">04</span>
    <span class="nav-text">Changelog</span>
  </a>
</nav>
