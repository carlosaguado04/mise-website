---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const items = [
  { href: "/#features", label: "Features", id: "features" },
  { href: "/#status", label: "Updates", id: "status" },
  { href: "/contact", label: "Contact", id: "contact" },
  { href: "/changelog", label: "Changelog", id: "changelog" },
] as const;

const current =
  path === "/contact" ? "contact" : path === "/changelog" ? "changelog" : undefined;
---

<a class="mark" href="/" aria-label="Mise home">
  <span class="mark-frame" aria-hidden="true"></span>
  <img class="mark-icon" src="/icon.png" width="32" height="32" alt="" />
</a>

<nav class="set" aria-label="Site">
  {
    items.map((item) => (
      <a
        class="set-pane"
        href={item.href}
        aria-current={current === item.id ? "page" : undefined}
      >
        <span class="set-pane-bar" aria-hidden="true"></span>
        <span class="set-pane-label">{item.label}</span>
      </a>
    ))
  }
</nav>
