---
import DownloadWait from "./DownloadWait.astro";

const path = Astro.url.pathname;
---

<header class="nav">
  <div class="nav-inner">
    <a class="brand" href="/">
      <img src="/icon.png" width="24" height="24" alt="" />
      Mise
    </a>
    <nav class="nav-links" id="site-nav" aria-label="Primary">
      <a href="/#features">Features</a>
      <a href="/#status">Updates</a>
      <a href="/contact" aria-current={path === "/contact" ? "page" : undefined}>Contact</a>
      <a href="/changelog" aria-current={path === "/changelog" ? "page" : undefined}>Changelog</a>
    </nav>
    <div class="nav-tools">
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Switch to light theme"
      >
        <span class="theme-toggle-icon" aria-hidden="true"></span>
      </button>
      <DownloadWait label="Download" class="btn-sm" />
      <button
        type="button"
        class="nav-toggle"
        id="nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span data-nav-label>Menu</span>
      </button>
    </div>
  </div>
  <div class="scroll-progress" aria-hidden="true"></div>
</header>
