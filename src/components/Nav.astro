---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const items = [
  { href: "/#features", label: "Features", id: "features" },
  { href: "/#pricing", label: "Pricing", id: "pricing" },
  { href: "/contact", label: "Contact", id: "contact" },
] as const;

const current = path === "/contact" ? "contact" : undefined;
---

<nav class="set" aria-label="Site">
  <a class="set-pane set-pane--home" href="/#top" aria-label="Back to top">
    <img src="/icon.png" width="22" height="22" alt="" />
  </a>
  {
    items.map((item) => (
      <a
        class="set-pane"
        href={item.href}
        aria-current={current === item.id ? "page" : undefined}
      >
        <span class="set-pane-bar" aria-hidden="true"></span>
        <span class="set-pane-label">{item.label}</span>
      </a>
    ))
  }
</nav>
