---
import DownloadWait from "./DownloadWait.astro";
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/">
      <img src="/icon.png" width="24" height="24" alt="" />
      Mise
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="/#features">Features</a>
      <a href="/#status">Updates</a>
      <a href="/contact">Contact</a>
      <a href="/changelog">Changelog</a>
      <div class="theme-picker" role="group" aria-label="Color theme">
        <button type="button" class="theme-btn" data-theme-set="dark" aria-pressed="true">Dark</button>
        <button type="button" class="theme-btn" data-theme-set="light" aria-pressed="false">Light</button>
      </div>
      <DownloadWait label="Download" class="btn-sm" />
    </nav>
  </div>
  <div class="scroll-progress" aria-hidden="true"></div>
</header>
