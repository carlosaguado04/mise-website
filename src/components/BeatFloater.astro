---
interface Props {
  label: string;
  tone?: "acid" | "ember" | "heat";
  href?: string;
}

const { label, tone = "acid", href } = Astro.props;
---

{
  href ? (
    <a class:list={["floater", `floater--${tone}`]} data-floater href={href}>
      {label}
    </a>
  ) : (
    <span class:list={["floater", `floater--${tone}`]} data-floater>
      {label}
    </span>
  )
}
