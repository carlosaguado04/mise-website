---
import { site } from "../site";
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <h2>Product</h2>
        <ul>
          <li><a href="/#features">Features</a></li>
          <li><a href="/#automate">Automations</a></li>
          <li><a href="/#terminals">Terminals</a></li>
          <li><a href="/#pricing">Pricing</a></li>
          <li><a href="/#status">Updates</a></li>
          <li>
            <span class="footer-wait" aria-disabled="true">
              <span class="btn-idle">Download</span>
              <span class="btn-alt">In development</span>
            </span>
          </li>
          <li><a href="/changelog">Changelog</a></li>
        </ul>
      </div>
      <div>
        <h2>Support</h2>
        <ul>
          <li><a href="/contact">Contact</a></li>
          <li><a href={site.xUrl}>@AppMise</a></li>
          <li><a href="/privacy#accessibility">Accessibility</a></li>
          <li><a href="/#keys">Hotkeys</a></li>
        </ul>
      </div>
      <div>
        <h2>Legal</h2>
        <ul>
          <li><a href="/privacy">Privacy</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-end">
      <img src="/icon.png" width="20" height="20" alt="" />
      <p>
        mise en place — the chef's ritual of arranging every tool before service.
        <span>© Carlos Aguado. All rights reserved.</span>
      </p>
      <div class="footer-mascot-wrap">
        <button
          type="button"
          class="footer-mascot"
          aria-label="Talk to the Mise mascot"
          data-mascot
        >
          <img src="/mascot.png" width="36" height="32" alt="" />
        </button>
        <div class="mascot-bubble" data-mascot-bubble hidden role="status" aria-live="polite"></div>
      </div>
    </div>
  </div>
</footer>