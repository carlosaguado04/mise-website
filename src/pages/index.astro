---
import Base from "../layouts/Base.astro";
import SetMark from "../components/SetMark.astro";
import KeyChip from "../components/KeyChip.astro";
import DownloadWait from "../components/DownloadWait.astro";
import SetDesktop from "../components/SetDesktop.astro";
import { site, jsonLd } from "../site";

const sets = [
  {
    id: "writing",
    name: "Writing",
    shortcut: "⌃⌥1",
    label: "Writing set: a wide document on the left, notes and a dictionary stacked on the right.",
    explain: "Draft on one side, notes and a reference stacked on the other.",
  },
  {
    id: "review",
    name: "Review",
    shortcut: "⌃⌥2",
    label: "Review set: Pages beside Preview.",
    explain: "The draft beside the PDF you’re checking.",
  },
  {
    id: "studio",
    name: "Studio",
    shortcut: "⌃⌥3",
    label: "Studio set: a timeline across the top, stills and soundtrack below.",
    explain: "Timeline up top, stills and soundtrack below.",
  },
] as const;

const terminals = [
  { name: "kitty", href: "https://sw.kovidgoyal.net/kitty/", icon: "/terminals/kitty.png" },
  { name: "Alacritty", href: "https://alacritty.org/", icon: "/terminals/alacritty.svg" },
  { name: "WezTerm", href: "https://wezterm.org/", icon: "/terminals/wezterm.svg" },
  { name: "Rio", href: "https://rioterm.com/", icon: "/terminals/rio.svg" },
  { name: "Terminal", href: "https://support.apple.com/guide/terminal/welcome/mac", icon: "/terminals/terminal.svg" },
  { name: "Ghostty", href: "https://ghostty.org/", icon: "/terminals/ghostty.png" },
  { name: "iTerm2", href: "https://iterm2.com/", icon: "/terminals/iterm2.png" },
] as const;
---

<Base jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero-shell">
      <div class="hero-copy">
        <h1>Every window where it belongs.<br />In <em>one click</em>.</h1>
        <p class="hero-sub">{site.description}</p>
        <div class="hero-actions">
          <DownloadWait />
          <p class="hero-price-note">Free to try · Pro is {site.proPrice} once</p>
        </div>
      </div>
      <div class="hero-visual">
        <figure
          class="shot hero-stage is-empty"
          aria-label="Empty desktop. After a click, Pages and Safari arrange 70/30."
        >
          <div class="hero-wallpaper" aria-hidden="true"></div>
          <div class="hero-acid" data-acid="hero" aria-hidden="true"></div>
          <span class="hero-click" aria-hidden="true"></span>
          {/* Empty wallpaper → click → Pages 70% + Safari 30%. */}
          <SetDesktop
            layout="wide"
            active
            windows={[
              { role: "main", icon: "pages.png", lit: true },
              { role: "tr", icon: "safari.png" },
            ]}
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="demo" id="demo" aria-label="Sets">
    <div class="wrap">
      <div class="demo-cards" data-reveal-group role="group" aria-label="Saved Sets">
        {
          sets.map((set, i) => (
            <button
              class:list={["set-card", i === 0 && "is-active"]}
              type="button"
              data-reveal
              data-set={set.id}
              data-set-name={set.name}
              data-set-shortcut={set.shortcut}
              data-set-label={set.label}
              data-set-explain={set.explain}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              <span class="set-card-top">
                <span class="set-card-name">{set.name}</span>
                <KeyChip k={set.shortcut} />
              </span>
              <SetMark variant={set.id} />
            </button>
          ))
        }
      </div>
      <figure
        class="shot demo-stage"
        data-reveal
        data-demo-stage
        aria-label={sets[0].label}
      >
        <div class="hero-acid" data-acid="demo" aria-hidden="true"></div>
        <SetDesktop
          layout="writing"
          demoId="writing"
          active
          windows={[
            { role: "main", icon: "pages.png", lit: true },
            { role: "tr", icon: "notes.png" },
            { role: "br", icon: "dictionary.png" },
          ]}
        />
        <SetDesktop
          layout="split"
          demoId="review"
          windows={[
            { role: "main", icon: "pages.png", lit: true },
            { role: "tr", icon: "preview.png" },
          ]}
        />
        <SetDesktop
          layout="stack"
          demoId="studio"
          windows={[
            { role: "main", icon: "final-cut.png", lit: true },
            { role: "tr", icon: "photoshop.png" },
            { role: "br", icon: "music.png" },
          ]}
        />
      </figure>
      <div class="demo-active" data-demo-active aria-live="polite">
        <p class="demo-active-row">
          <span data-demo-active-name>Writing</span>
          <KeyChip k="⌃⌥1" />
        </p>
        <p class="demo-explain" data-demo-explain>
          Draft on one side, notes and a reference stacked on the other.
        </p>
      </div>
      <p class="demo-caption">Capture what’s on screen, name it, stop babysitting it.</p>
    </div>
  </section>

  <section class="features wrap" id="features">
    <article class="feature" data-reveal-group>
      <div class="feature-copy" data-reveal>
        <h2>Capture what’s already there.</h2>
        <p>Arrange once. Hit Capture. Mise stores the real frames — not a “smart” guess.</p>
      </div>
      <figure
        class="shot feature-visual"
        data-reveal
        aria-label="Stylized desktop mid-capture into a Set."
      >
        <div class="hero-wallpaper" aria-hidden="true"></div>
        <div class="feature-capture" aria-hidden="true">
          <span class="hero-window feature-capture-win feature-capture-win--pages">
            <img src="/hero-apps/pages.png" width="256" height="256" alt="" />
          </span>
          <span class="hero-window feature-capture-win feature-capture-win--safari">
            <img src="/hero-apps/safari.png" width="256" height="256" alt="" />
          </span>
          <span class="hero-window feature-capture-win feature-capture-win--notes">
            <img src="/hero-apps/notes.png" width="256" height="256" alt="" />
          </span>
          <span class="feature-capture-chip">Capture</span>
        </div>
      </figure>
    </article>

    <article class="feature feature--flip" data-reveal-group>
      <div class="feature-copy" data-reveal>
        <h2>Across every display. <span class="pro-tag">Pro</span></h2>
        <p>
          Each window remembers its monitor. Unplug, replug, stop playing 52-card pickup.
        </p>
      </div>
      <figure
        class="shot feature-visual"
        data-reveal
        aria-label="Stylized dual monitors with a Set spanning both displays."
      >
        <div class="feature-displays" aria-hidden="true">
          <div class="feature-monitor">
            <div class="feature-monitor-bezel">
              <div class="hero-wallpaper"></div>
              <div class="hero-desktop is-on feature-monitor-desktop feature-monitor-desktop--solo">
                <span class="hero-window hero-window--main hero-window--lit">
                  <img src="/hero-apps/pages.png" width="256" height="256" alt="" />
                </span>
              </div>
            </div>
            <span class="feature-monitor-stand"></span>
            <span class="feature-monitor-base"></span>
          </div>
          <div class="feature-monitor">
            <div class="feature-monitor-bezel">
              <div class="hero-wallpaper"></div>
              <div class="hero-desktop is-on feature-monitor-desktop feature-monitor-desktop--split">
                <span class="hero-window hero-window--main">
                  <img src="/hero-apps/safari.png" width="256" height="256" alt="" />
                </span>
                <span class="hero-window hero-window--tr">
                  <img src="/hero-apps/notes.png" width="256" height="256" alt="" />
                </span>
              </div>
            </div>
            <span class="feature-monitor-stand"></span>
            <span class="feature-monitor-base"></span>
          </div>
        </div>
      </figure>
    </article>
  </section>

  <section class="terminals wrap" id="terminals">
    <h2 data-reveal>Restore the tmux session. <span class="pro-tag">Pro</span></h2>
    <p data-reveal>
      Name a tmux session on a slot. Still running? Attach. Dead? Recreate it. Closing the window
      doesn’t murder the work.
    </p>
    <ul class="term-list" data-reveal-group>
      {
        terminals.map((term) => (
          <li data-reveal>
            <a href={term.href} rel="noopener noreferrer" target="_blank">
              <img src={term.icon} width="20" height="20" alt="" />
              {term.name}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="term-note" data-reveal>
      Other terminals still open and land in their frames, but without a saved command or session.
      Those apps can’t launch a new window with a command from the shell. Warp and Hyper are two
      examples.
    </p>
  </section>

  <section class="keys wrap" id="keys">
    <h2 data-reveal>A key for each Set. <span class="pro-tag">Pro</span></h2>
    <ul class="shortcuts" data-reveal-group>
      <li data-reveal>
        <KeyChip k="⌃⌥1–9" />
        <span>run a set</span>
      </li>
      <li data-reveal>
        <KeyChip k="⌃⌥C" />
        <span>capture current windows</span>
      </li>
      <li data-reveal>
        <KeyChip k="⌃⌥E" />
        <span>edit the active set</span>
      </li>
    </ul>
  </section>

  <section class="automate wrap" id="automate">
    <h2 data-reveal>Automate with Shortcuts and Raycast.</h2>
    <p class="automate-lead" data-reveal>
      Same Sets. Apple Shortcuts or Raycast. No extra ritual.
    </p>
    <div class="automate-cards" data-reveal-group>
      <article class="automate-card" data-reveal>
        <header class="automate-card-head">
          <img src="/integrations/shortcuts.svg" width="28" height="28" alt="" class="automate-icon automate-icon--shortcuts" />
          <div>
            <h3>Apple Shortcuts</h3>
            <p class="automate-tag">Built-in actions</p>
          </div>
        </header>
        <ol class="automate-steps">
          <li>Install Mise (use a Development- or Developer ID–signed build so Shortcuts can reach it).</li>
          <li>Open the <strong>Shortcuts</strong> app on your Mac.</li>
          <li>New Shortcut → search <strong>Mise</strong> or <strong>Apply Set</strong>.</li>
          <li>Add <strong>Apply Set</strong> and pick a Set (same free apply as the menu bar).</li>
          <li>Optional: add <strong>Reload Sets</strong> if you edit layouts.json by hand.</li>
          <li>Run the shortcut — windows rearrange. If Mise doesn’t show up, quit Shortcuts (⌘Q) and reopen once after installing Mise.</li>
        </ol>
        <p class="automate-note">
          Or use Open URL: <code>layouts://apply?name=Your%20Set</code> needs Pro; <code>layouts://reload</code> is Free.
        </p>
      </article>
      <article class="automate-card" data-reveal>
        <header class="automate-card-head">
          <img src="/integrations/raycast.svg" width="28" height="28" alt="" class="automate-icon" />
          <div>
            <h3>Raycast</h3>
            <p class="automate-tag">Mise Window Sets</p>
          </div>
        </header>
        <p>
          Search Sets in Raycast and apply them. Listing is free; apply uses <code>layouts://</code> and needs Mise Pro.
        </p>
        {site.raycastStoreUrl ? (
          <a class="btn" href={site.raycastStoreUrl} rel="noopener noreferrer" target="_blank">
            View on Raycast Store
          </a>
        ) : (
          <button class="btn btn-wait" type="button" aria-disabled="true">
            <span class="btn-idle">View on Raycast Store</span>
            <span class="btn-alt">Coming soon</span>
          </button>
        )}
      </article>
    </div>
  </section>

  <section class="pricing wrap" id="pricing">
    <h2 data-reveal>Two Sets for free. The rest is $9.99 once.</h2>
    <div class="price-cards" data-reveal-group>
      <article class="price-card" data-reveal>
        <h3>Free</h3>
        <p class="price-amount">$0</p>
        <p class="price-line">Forever. Two Sets.</p>
        <ul>
          <li>Capture and restore</li>
          <li>Edit your Sets</li>
          <li>Menu bar, always</li>
        </ul>
        <p class="price-foot">Enough to know if you’re the kind of person who notices.</p>
      </article>
      <article class="price-card price-card--pro" data-reveal>
        <h3>Pro</h3>
        <p class="price-amount">{site.proPrice}</p>
        <p class="price-line">One-time. Yours.</p>
        <ul>
          <li>Unlimited Sets</li>
          <li>Multi-display layouts</li>
          <li>Global hotkeys (⌃⌥)</li>
          <li>Terminal command + tmux slots</li>
          <li><code>layouts://</code> / Shortcuts</li>
        </ul>
        <p class="price-foot">No subscription. We’re not that kind of studio.</p>
      </article>
    </div>
    <p class="price-note" data-reveal>
      Unlocks on your Mac. No account. No drip.
    </p>
  </section>

  <section class="status wrap" id="status">
    <h2 data-reveal>Still cooking.</h2>
    <p data-reveal>
      Download isn’t up yet. Follow <a href={site.xUrl}>@AppMise</a> if you like waiting with your
      windows already where they belong, in spirit.
    </p>
  </section>
</Base>