---
import Base from "../layouts/Base.astro";
import SetMark from "../components/SetMark.astro";
import KeyChip from "../components/KeyChip.astro";
import DownloadWait from "../components/DownloadWait.astro";
import SetDesktop from "../components/SetDesktop.astro";
import { site, jsonLd } from "../site";

const sets = [
  {
    id: "writing",
    name: "Writing",
    shortcut: "⌃⌥1",
    label: "Writing set: a document beside a notes pane.",
    explain: "Draft on one side, notes on the other.",
  },
  {
    id: "review",
    name: "Review",
    shortcut: "⌃⌥2",
    label: "Review set: a document beside a PDF reader.",
    explain: "The draft beside the PDF you’re checking.",
  },
  {
    id: "studio",
    name: "Studio",
    shortcut: "⌃⌥3",
    label: "Studio set: a timeline across the top, stills and soundtrack below.",
    explain: "Timeline up top, stills and soundtrack below.",
  },
] as const;

const terminals = [
  { name: "kitty", href: "https://sw.kovidgoyal.net/kitty/", icon: "/terminals/kitty.png" },
  { name: "Alacritty", href: "https://alacritty.org/", icon: "/terminals/alacritty.svg" },
  { name: "WezTerm", href: "https://wezterm.org/", icon: "/terminals/wezterm.svg" },
  { name: "Rio", href: "https://rioterm.com/", icon: "/terminals/rio.svg" },
  { name: "Terminal", href: "https://support.apple.com/guide/terminal/welcome/mac", icon: "/terminals/terminal.svg" },
  { name: "Ghostty", href: "https://ghostty.org/", icon: "/terminals/ghostty.png" },
  { name: "iTerm2", href: "https://iterm2.com/", icon: "/terminals/iterm2.png" },
] as const;
---

<Base jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap">
      <h1>Every window where it belongs.<br />In <em>one click</em>.</h1>
      <p class="hero-sub">{site.description}</p>
      <div class="hero-actions">
        <DownloadWait />
      </div>
      <div class="hero-visual">
        <div class="hero-glow" aria-hidden="true"></div>
        <figure
          class="shot hero-stage is-chaos"
          aria-label="Messy windows snap into a tidy desktop in one click."
        >
          <div class="hero-acid" data-acid="hero" aria-hidden="true"></div>
          {/* Chaos → Set: same day-desk, messy then snapped. Demo owns Writing/Review/Studio. */}
          <SetDesktop
            layout="writing"
            active
            windows={[
              { role: "main", icon: "safari.png", lit: true },
              { role: "tr", icon: "mail.png" },
              { role: "br", icon: "calendar.png" },
            ]}
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="demo" id="demo" aria-label="Sets">
    <div class="wrap">
      <div class="demo-cards" data-reveal-group role="group" aria-label="Saved Sets">
        {
          sets.map((set, i) => (
            <button
              class:list={["set-card", i === 0 && "is-active"]}
              type="button"
              data-reveal
              data-set={set.id}
              data-set-name={set.name}
              data-set-shortcut={set.shortcut}
              data-set-label={set.label}
              data-set-explain={set.explain}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              <span class="set-card-top">
                <span class="set-card-name">{set.name}</span>
                <KeyChip k={set.shortcut} />
              </span>
              <SetMark variant={set.id} />
            </button>
          ))
        }
      </div>
      <figure
        class="shot demo-stage"
        data-reveal
        data-demo-stage
        aria-label={sets[0].label}
      >
        <div class="hero-acid" data-acid="demo" aria-hidden="true"></div>
        <SetDesktop
          layout="split"
          demoId="writing"
          active
          windows={[
            { role: "main", icon: "pages.png", lit: true },
            { role: "tr", icon: "notes.png" },
          ]}
        />
        <SetDesktop
          layout="split"
          demoId="review"
          windows={[
            { role: "main", icon: "pages.png", lit: true },
            { role: "tr", icon: "acrobat.png" },
          ]}
        />
        <SetDesktop
          layout="stack"
          demoId="studio"
          windows={[
            { role: "main", icon: "final-cut.png", lit: true },
            { role: "tr", icon: "photoshop.png" },
            { role: "br", icon: "music.png" },
          ]}
        />
      </figure>
      <div class="demo-active" data-demo-active aria-live="polite">
        <p class="demo-active-row">
          <span data-demo-active-name>Writing</span>
          <KeyChip k="⌃⌥1" />
        </p>
        <p class="demo-explain" data-demo-explain>
          Draft on one side, notes on the other.
        </p>
      </div>
      <p class="demo-caption">Sets are yours: capture what's on screen, name it, forget about it.</p>
    </div>
  </section>

  <section class="features wrap" id="features">
    <article class="feature" data-reveal-group>
      <div class="feature-copy" data-reveal>
        <h2>Capture what's already there.</h2>
        <p>Arrange your windows once, then press Capture. Mise stores the frames, not a guess.</p>
      </div>
      <figure class="shot feature-visual" data-reveal>
        <img
          src="/feature-capture.png"
          width="640"
          height="480"
          alt="The Capture action storing the current window frames as a Set."
          loading="lazy"
          decoding="async"
        />
      </figure>
    </article>

    <article class="feature feature--flip" data-reveal-group>
      <div class="feature-copy" data-reveal>
        <h2>Across every display.</h2>
        <p>
          Sets remember which monitor each window lived on, as fractions — so they survive
          resolution changes and reconnects.
        </p>
      </div>
      <figure class="shot feature-visual" data-reveal>
        <img
          src="/feature-displays.png"
          width="640"
          height="480"
          alt="A Set placed across two displays, each window on the monitor it belongs to."
          loading="lazy"
          decoding="async"
        />
      </figure>
    </article>
  </section>

  <section class="terminals wrap" id="terminals">
    <h2 data-reveal>Restore the tmux session.</h2>
    <p data-reveal>
      Name a session on a terminal slot. Mise attaches if it's still running, or creates it and
      runs the command if it isn't. Closing the window doesn't kill the work.
    </p>
    <ul class="term-list" data-reveal-group>
      {
        terminals.map((term) => (
          <li data-reveal>
            <a href={term.href} rel="noopener noreferrer" target="_blank">
              <img src={term.icon} width="20" height="20" alt="" />
              {term.name}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="term-note" data-reveal>
      Other terminals still open and land in their frames, but without the saved command or
      session. They have no way to open a new window with a command from the command line.
      Warp and Hyper are two examples.
    </p>
  </section>

  <section class="keys wrap" id="keys">
    <h2 data-reveal>A key for each Set.</h2>
    <ul class="shortcuts" data-reveal-group>
      <li data-reveal>
        <KeyChip k="⌃⌥1–9" />
        <span>run a set</span>
      </li>
      <li data-reveal>
        <KeyChip k="⌃⌥C" />
        <span>capture current windows</span>
      </li>
      <li data-reveal>
        <KeyChip k="⌃⌥E" />
        <span>edit the active set</span>
      </li>
    </ul>
    <p data-reveal>
      Off until you turn them on in Settings. A global shortcut is a system-wide change, not a default.
    </p>
  </section>

  <section class="status wrap" id="status">
    <h2 data-reveal>In development.</h2>
    <p data-reveal>
      Follow <a href={site.xUrl}>@AppMise</a> for updates.
    </p>
  </section>
</Base>
