---
import Base from "../layouts/Base.astro";
import BeatFloater from "../components/BeatFloater.astro";
import DownloadCtas from "../components/DownloadCtas.astro";
import { site, jsonLd } from "../site";

const sets = [
  { id: "laptop", label: "Laptop" },
  { id: "desk", label: "Desk" },
  { id: "focus", label: "Focus" },
] as const;
---

<Base page="home" jsonLd={jsonLd}>
  <section class="home" data-home aria-label="Mise">
    <div class="home-hero">
      <h1 class="wordmark">Mise</h1>
      <p class="hero-line">{site.tagline}</p>
      <p class="hero-sub">Capture the desk once. Put it back when the windows wander.</p>
    </div>

    <div class="field" data-field>
      <div class="field-cluster" data-cluster data-layout="laptop" aria-hidden="true">
        <span class="frame" data-slot="a"></span>
        <span class="frame" data-slot="b"></span>
        <span class="frame" data-slot="c"></span>
      </div>
      <ul class="set-switch" data-sets>
        {
          sets.map((set, i) => (
            <li>
              <button type="button" data-set={set.id} aria-pressed={i === 0 ? "true" : "false"}>
                {set.label}
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="home-cta">
      <DownloadCtas compact raycast={false} />
      <nav class="home-hops" aria-label="More">
        <BeatFloater label="Features" tone="acid" href="/features" />
        <BeatFloater label="Pricing" tone="heat" href="/pro" />
      </nav>
    </div>
  </section>
</Base>
