---
import Base from "../layouts/Base.astro";
import Desk from "../components/Desk.astro";
import KeyChip from "../components/KeyChip.astro";
import DownloadWait from "../components/DownloadWait.astro";
import { site, jsonLd } from "../site";

const heroSub = [
  "Capture",
  "the",
  "desk",
  "once.",
  "Put",
  "it",
  "back",
  "in",
  "one",
  "click.",
] as const;

const terminals = [
  { name: "kitty", href: "https://sw.kovidgoyal.net/kitty/", icon: "/terminals/kitty.png" },
  { name: "Alacritty", href: "https://alacritty.org/", icon: "/terminals/alacritty.svg" },
  { name: "WezTerm", href: "https://wezterm.org/", icon: "/terminals/wezterm.svg" },
  { name: "Rio", href: "https://rioterm.com/", icon: "/terminals/rio.svg" },
  { name: "Terminal", href: "https://support.apple.com/guide/terminal/welcome/mac", icon: "/terminals/terminal.svg" },
  { name: "Ghostty", href: "https://ghostty.org/", icon: "/terminals/ghostty.png" },
  { name: "iTerm2", href: "https://iterm2.com/", icon: "/terminals/iterm2.png" },
] as const;

const writeWins = [
  { name: "Safari", icon: "/hero-apps/safari.png", area: "main" },
  { name: "Notes", icon: "/hero-apps/notes.png", area: "side" },
  { name: "Pages", icon: "/hero-apps/pages.png", area: "base" },
] as const;

const codeWins = [
  { name: "kitty", icon: "/terminals/kitty.png", area: "main", note: "$ tmux attach -t code" },
  { name: "Safari", icon: "/hero-apps/safari.png", area: "side" },
  { name: "Preview", icon: "/hero-apps/preview.png", area: "base" },
] as const;

const editWins = [
  { name: "Final Cut", icon: "/hero-apps/final-cut.png", area: "main" },
  { name: "Music", icon: "/hero-apps/music.png", area: "side" },
  { name: "Safari", icon: "/hero-apps/safari.png", area: "base" },
] as const;
---

<Base jsonLd={jsonLd}>
  <section class="hero" id="top">
    <div class="hero-shell">
      <div class="hero-copy">
        <img class="hero-mark" src="/icon.png" width="64" height="64" alt="" />
        <h1>
          <span class="hero-line">
            <span class="hero-word" style="--i: 0"><span>Every</span></span>
            <span class="hero-word" style="--i: 1"><span>window</span></span>
            <span class="hero-word" style="--i: 2"><span>where</span></span>
            <span class="hero-word" style="--i: 3"><span>it</span></span>
            <span class="hero-word" style="--i: 4"><span>belongs.</span></span>
          </span>
          <span class="hero-line">
            <span class="hero-word" style="--i: 5"><span>In</span></span>
            <em class="hero-word hero-word--acid" style="--i: 6"><span>one click.</span></em>
          </span>
        </h1>
        <p class="hero-sub">
          {
            heroSub.map((word, i) => (
              <span class="sub-word" style={`--i: ${i}`}>
                <span>{word}</span>
              </span>
            ))
          }
        </p>
        <span class="hero-rule" aria-hidden="true"></span>
        <div class="hero-actions">
          <DownloadWait />
          <p class="hero-price-note">{site.minOs} · Free to try · Pro is {site.proPrice} once</p>
        </div>
      </div>
      <Desk name="Write" hotkey="⌃⌥1" live wins={[...writeWins]} />
    </div>
  </section>

  <section class="how wrap" id="features">
    <p class="eyebrow" data-reveal>How a Set works</p>
    <h2 data-reveal>Arrange the kitchen. Mise remembers the stations.</h2>
    <ol class="how-steps">
      <li data-reveal>
        <span class="how-n">01</span>
        <h3>Arrange</h3>
        <p>Put Safari, Notes, the terminal — whatever you actually use — where they already want to live.</p>
      </li>
      <li data-reveal>
        <span class="how-n">02</span>
        <h3>Capture</h3>
        <p>
          Hit Capture. Mise stores the real frames. Not a “smart” guess. Not a template you have to fight.
        </p>
      </li>
      <li data-reveal>
        <span class="how-n">03</span>
        <h3>Restore</h3>
        <p>One click, or <KeyChip k="⌃⌥1" />. Every app launches, sizes, and lands. Including the other display.</p>
      </li>
    </ol>
  </section>

  <section class="gallery wrap" aria-label="Example Sets">
    <p class="eyebrow" data-reveal>Sets</p>
    <h2 data-reveal>A named desk. Not a pile.</h2>
    <p class="lede" data-reveal>
      Two Sets free. Name the rest. Each one is a real layout you already made, waiting in the menu bar.
    </p>
    <div class="gallery-grid">
      <div class="gallery-item" data-reveal>
        <Desk name="Write" hotkey="⌃⌥1" compact wins={[...writeWins]} />
      </div>
      <div class="gallery-item" data-reveal>
        <Desk name="Code" hotkey="⌃⌥2" compact wins={[...codeWins]} />
      </div>
      <div class="gallery-item" data-reveal>
        <Desk name="Edit" hotkey="⌃⌥3" compact wins={[...editWins]} />
      </div>
    </div>
  </section>

  <section class="band wrap" id="displays">
    <article class="band-copy" data-reveal>
      <h2>Across every display. <span class="pro-tag">Pro</span></h2>
      <p>Each window remembers its monitor. Unplug, replug, stop playing 52-card pickup.</p>
    </article>
    <div class="monitors" aria-hidden="true" data-reveal>
      <div class="monitor monitor--lg">
        <span class="monitor-label">Built-in</span>
        <span class="monitor-pane"></span>
        <span class="monitor-pane monitor-pane--wide"></span>
      </div>
      <div class="monitor">
        <span class="monitor-label">Studio</span>
        <span class="monitor-pane"></span>
      </div>
    </div>
  </section>

  <section class="band wrap band--flip" id="terminals">
    <article class="band-copy" data-reveal>
      <h2>Restore the tmux session. <span class="pro-tag">Pro</span></h2>
      <p>
        Name a tmux session on a slot. Still running? Attach. Dead? Recreate it. Closing the window doesn’t
        murder the work.
      </p>
      <ul class="term-list">
        {
          terminals.map((term) => (
            <li>
              <a href={term.href} rel="noopener noreferrer" target="_blank">
                <img src={term.icon} width="20" height="20" alt="" />
                {term.name}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="term-note">
        Other terminals still open and land in their frames, but without a saved command or session. Those
        apps can’t launch a new window with a command from the shell. Warp and Hyper are two examples.
      </p>
    </article>
    <div class="keys" id="keys" data-reveal>
      <h2>A key for each Set. <span class="pro-tag">Pro</span></h2>
      <ul class="shortcuts">
        <li>
          <KeyChip k="⌃⌥1–9" />
          <span>run a set</span>
        </li>
        <li>
          <KeyChip k="⌃⌥C" />
          <span>capture current windows</span>
        </li>
        <li>
          <KeyChip k="⌃⌥E" />
          <span>edit the active set</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="automate wrap" id="automate">
    <h2 data-reveal>Automate with Shortcuts and Raycast.</h2>
    <p class="automate-lead" data-reveal>Same Sets. Apple Shortcuts or Raycast. No extra ritual.</p>
    <div class="automate-cards">
      <article class="automate-card" data-reveal>
        <header class="automate-card-head">
          <img src="/integrations/shortcuts.svg" width="28" height="28" alt="" class="automate-icon automate-icon--shortcuts" />
          <div>
            <h3>Apple Shortcuts</h3>
            <p class="automate-tag">Built-in actions</p>
          </div>
        </header>
        <p>
          Mise shows up in the Shortcuts app as native actions. Search Mise, add Apply Set, pick a layout.
          Run it — every window launches, sizes, and lands.
        </p>
        <ul class="automate-features">
          <li>Apply Set — same restore as the menu bar</li>
          <li>Reload Sets — if you changed them outside the app</li>
          <li>Siri — “Apply my Set in Mise”</li>
          <li>Drop it into Focus, login, or any larger shortcut</li>
        </ul>
      </article>
      <article class="automate-card" data-reveal>
        <header class="automate-card-head">
          <img src="/integrations/raycast.svg" width="28" height="28" alt="" class="automate-icon" />
          <div>
            <h3>Raycast</h3>
            <p class="automate-tag">Mise Window Sets</p>
          </div>
        </header>
        <p>Search Sets in Raycast and apply them. Listing is free. Applying a Set needs Mise Pro.</p>
        <a
          href="https://www.raycast.com/carlosaguado04/mise-window-sets"
          title="Install mise-window-sets Raycast Extension"
          rel="noopener noreferrer"
          target="_blank"
        >
          <img
            src="https://www.raycast.com/carlosaguado04/mise-window-sets/install_button@2x.png?v=1.1"
            height="64"
            style="height: 64px;"
            width="auto"
            alt="Install mise-window-sets on Raycast"
            loading="lazy"
            decoding="async"
          />
        </a>
      </article>
    </div>
  </section>

  <section class="pricing wrap" id="pricing">
    <h2 data-reveal>Two Sets for free. The rest is $9.99 once.</h2>
    <p class="price-note" data-reveal>Unlocks on your Mac. No account. No drip.</p>
    <div class="price-cards">
      <article class="price-card" data-reveal>
        <h3>Free</h3>
        <p class="price-amount">$0</p>
        <p class="price-line">Forever. Two Sets.</p>
        <ul>
          <li>Capture and restore</li>
          <li>Edit your Sets</li>
          <li>Menu bar, always</li>
        </ul>
        <p class="price-foot">Enough to know if you’re the kind of person who notices.</p>
      </article>
      <article class="price-card price-card--pro" data-reveal>
        <h3>Pro</h3>
        <p class="price-amount">{site.proPrice}</p>
        <p class="price-line">One-time. Yours.</p>
        <ul>
          <li>Unlimited Sets</li>
          <li>Multi-display layouts</li>
          <li>Global hotkeys (⌃⌥)</li>
          <li>Terminal command + tmux slots</li>
          <li>Raycast apply</li>
        </ul>
        <p class="price-foot">No subscription. We’re not that kind of studio.</p>
      </article>
    </div>
  </section>

  <section class="status wrap" id="status">
    <h2 data-reveal>Still cooking.</h2>
    <p data-reveal>
      Download isn’t up yet. Follow <a href={site.xUrl}>@AppMise</a> if you like waiting with your windows
      already where they belong, in spirit.
    </p>
  </section>
</Base>
