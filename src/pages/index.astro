---
import Base from "../layouts/Base.astro";
import KeyChip from "../components/KeyChip.astro";
import DownloadWait from "../components/DownloadWait.astro";
import { site, jsonLd } from "../site";

const heroSub = [
  "Capture",
  "the",
  "desk",
  "once.",
  "Put",
  "it",
  "back",
  "in",
  "one",
  "click.",
] as const;

const terminals = [
  { name: "kitty", href: "https://sw.kovidgoyal.net/kitty/", icon: "/terminals/kitty.png" },
  { name: "Alacritty", href: "https://alacritty.org/", icon: "/terminals/alacritty.svg" },
  { name: "WezTerm", href: "https://wezterm.org/", icon: "/terminals/wezterm.svg" },
  { name: "Rio", href: "https://rioterm.com/", icon: "/terminals/rio.svg" },
  { name: "Terminal", href: "https://support.apple.com/guide/terminal/welcome/mac", icon: "/terminals/terminal.svg" },
  { name: "Ghostty", href: "https://ghostty.org/", icon: "/terminals/ghostty.png" },
  { name: "iTerm2", href: "https://iterm2.com/", icon: "/terminals/iterm2.png" },
] as const;
---

<Base jsonLd={jsonLd}>
  <section class="hero" data-field-set="scatter">
    <div class="hero-shell">
      <img class="hero-mark" src="/icon.png" width="64" height="64" alt="" />
      <h1>
        <span class="hero-line">
          <span class="hero-word" style="--i: 0"><span>Every</span></span>
          <span class="hero-word" style="--i: 1"><span>window</span></span>
          <span class="hero-word" style="--i: 2"><span>where</span></span>
          <span class="hero-word" style="--i: 3"><span>it</span></span>
          <span class="hero-word" style="--i: 4"><span>belongs.</span></span>
        </span>
        <span class="hero-line">
          <span class="hero-word" style="--i: 5"><span>In</span></span>
          <em class="hero-word hero-word--acid" style="--i: 6"><span>one click.</span></em>
        </span>
      </h1>
      <p class="hero-sub">
        {
          heroSub.map((word, i) => (
            <span class="sub-word" style={`--i: ${i}`}>
              <span>{word}</span>
            </span>
          ))
        }
      </p>
      <span class="hero-rule" aria-hidden="true"></span>
      <div class="hero-actions">
        <DownloadWait />
        <p class="hero-price-note">{site.minOs} · Free to try · Pro is {site.proPrice} once</p>
      </div>
    </div>
  </section>

  <section class="features wrap" id="features" data-field-set="pair" data-stage>
    <article class="feature" data-slot="copy">
      <div class="feature-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="6.5" y="10.5" width="28" height="20" rx="6" stroke="currentColor" stroke-width="1.5"></rect>
          <rect x="16.5" y="18.5" width="25" height="19" rx="6" stroke="currentColor" stroke-width="1.5"></rect>
        </svg>
      </div>
      <div class="feature-copy">
        <h2>Capture what’s already there.</h2>
        <p>Arrange once. Hit Capture. Mise stores the real frames — not a “smart” guess.</p>
      </div>
    </article>

    <article class="feature" data-slot="copy">
      <div class="feature-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="3.5" y="12.5" width="18" height="23" rx="5" stroke="currentColor" stroke-width="1.5"></rect>
          <rect x="26.5" y="12.5" width="18" height="23" rx="5" stroke="currentColor" stroke-width="1.5"></rect>
        </svg>
      </div>
      <div class="feature-copy">
        <h2>Across every display. <span class="pro-tag">Pro</span></h2>
        <p>Each window remembers its monitor. Unplug, replug, stop playing 52-card pickup.</p>
      </div>
    </article>
  </section>

  <section class="terminals wrap" id="terminals" data-field-set="dev" data-stage>
    <div class="stage-copy" data-slot="copy">
      <h2>Restore the tmux session. <span class="pro-tag">Pro</span></h2>
      <p>
        Name a tmux session on a slot. Still running? Attach. Dead? Recreate it. Closing the window
        doesn’t murder the work.
      </p>
    </div>
    <div class="term-pane" data-slot="card">
      <ul class="term-list">
        {
          terminals.map((term) => (
            <li>
              <a href={term.href} rel="noopener noreferrer" target="_blank">
                <img src={term.icon} width="20" height="20" alt="" />
                {term.name}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="term-note">
        Other terminals still open and land in their frames, but without a saved command or session.
        Those apps can’t launch a new window with a command from the shell. Warp and Hyper are two
        examples.
      </p>
    </div>
    <div class="keys" id="keys" data-slot="card">
      <h2>A key for each Set. <span class="pro-tag">Pro</span></h2>
      <ul class="shortcuts">
        <li>
          <KeyChip k="⌃⌥1–9" />
          <span>run a set</span>
        </li>
        <li>
          <KeyChip k="⌃⌥C" />
          <span>capture current windows</span>
        </li>
        <li>
          <KeyChip k="⌃⌥E" />
          <span>edit the active set</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="automate wrap" id="automate" data-field-set="split" data-stage>
    <div class="stage-copy" data-slot="copy">
      <h2>Automate with Shortcuts and Raycast.</h2>
      <p class="automate-lead">Same Sets. Apple Shortcuts or Raycast. No extra ritual.</p>
    </div>
    <div class="automate-cards">
      <article class="automate-card" data-slot="card">
        <header class="automate-card-head">
          <img src="/integrations/shortcuts.svg" width="28" height="28" alt="" class="automate-icon automate-icon--shortcuts" />
          <div>
            <h3>Apple Shortcuts</h3>
            <p class="automate-tag">Built-in actions</p>
          </div>
        </header>
        <p>
          Mise shows up in the Shortcuts app as native actions. Search Mise, add Apply Set, pick a
          layout. Run it — every window launches, sizes, and lands.
        </p>
        <ul class="automate-features">
          <li>Apply Set — same restore as the menu bar</li>
          <li>Reload Sets — if you changed them outside the app</li>
          <li>Siri — “Apply my Set in Mise”</li>
          <li>Drop it into Focus, login, or any larger shortcut</li>
        </ul>
      </article>
      <article class="automate-card" data-slot="card">
        <header class="automate-card-head">
          <img src="/integrations/raycast.svg" width="28" height="28" alt="" class="automate-icon" />
          <div>
            <h3>Raycast</h3>
            <p class="automate-tag">Mise Window Sets</p>
          </div>
        </header>
        <p>
          Search Sets in Raycast and apply them. Listing is free. Applying a Set needs Mise Pro.
        </p>
        <a
          href="https://www.raycast.com/carlosaguado04/mise-window-sets"
          title="Install mise-window-sets Raycast Extension"
          rel="noopener noreferrer"
          target="_blank"
        >
          <img
            src="https://www.raycast.com/carlosaguado04/mise-window-sets/install_button@2x.png?v=1.1"
            height="64"
            style="height: 64px;"
            width="auto"
            alt="Install mise-window-sets on Raycast"
            loading="lazy"
            decoding="async"
          />
        </a>
      </article>
    </div>
  </section>

  <section class="pricing wrap" id="pricing" data-field-set="write" data-stage>
    <div class="stage-copy" data-slot="copy">
      <h2>Two Sets for free. The rest is $9.99 once.</h2>
      <p class="price-note">Unlocks on your Mac. No account. No drip.</p>
    </div>
    <div class="price-cards">
      <article class="price-card" data-slot="card">
        <h3>Free</h3>
        <p class="price-amount">$0</p>
        <p class="price-line">Forever. Two Sets.</p>
        <ul>
          <li>Capture and restore</li>
          <li>Edit your Sets</li>
          <li>Menu bar, always</li>
        </ul>
        <p class="price-foot">Enough to know if you’re the kind of person who notices.</p>
      </article>
      <article class="price-card price-card--pro" data-slot="card">
        <h3>Pro</h3>
        <p class="price-amount">{site.proPrice}</p>
        <p class="price-line">One-time. Yours.</p>
        <ul>
          <li>Unlimited Sets</li>
          <li>Multi-display layouts</li>
          <li>Global hotkeys (⌃⌥)</li>
          <li>Terminal command + tmux slots</li>
          <li>Raycast apply</li>
        </ul>
        <p class="price-foot">No subscription. We’re not that kind of studio.</p>
      </article>
    </div>
  </section>

  <section class="status wrap" id="status" data-field-set="focus" data-stage>
    <div class="stage-copy" data-slot="copy">
      <h2>Still cooking.</h2>
      <p>
        Download isn’t up yet. Follow <a href={site.xUrl}>@AppMise</a> if you like waiting with your
        windows already where they belong, in spirit.
      </p>
    </div>
  </section>
</Base>
