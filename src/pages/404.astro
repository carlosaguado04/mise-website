---
import Base from "../layouts/Base.astro";
import { site } from "../site";
---

<Base page="notfound" title={`Not found — ${site.name}`} description="That page is not on this site.">
  <header class="page-head">
    <h1 class="page-title">Not found</h1>
  </header>
  <p class="legal-prose">
    That URL is not a page. <a href="/">Back to Mise</a>.
  </p>
</Base>
